{
  "expo": {
    "name": "Snipe Hub",
    "slug": "snipe-hub",
    "version": "0.4.0",
    "orientation": "portrait",
    "scheme": "snipehub",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0d0d10",
    "primaryColor": "#ff6b6f",
    "icon": "./assets/icon.png",
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "bundleIdentifier": "com.saliox.snipehub",
      "supportsTablet": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "UIBackgroundModes": ["fetch"]
      }
    },
    "android": {
      "package": "com.saliox.snipehub",
      "edgeToEdgeEnabled": true,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0d0d10"
      },
      "permissions": [
        "INTERNET",
        "ACCESS_NETWORK_STATE",
        "RECEIVE_BOOT_COMPLETED",
        "WAKE_LOCK",
        "POST_NOTIFICATIONS"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      "expo-notifications",
      ["expo-splash-screen", {
        "image": "./assets/splash-icon.png",
        "imageWidth": 220,
        "resizeMode": "contain",
        "backgroundColor": "#0d0d10"
      }]
    ],
    "extra": {
      "updateRepo": "saliox/snipe-hub"
    }
  }
}
